DATA_DIR=data
HTTP_TIMEOUT=30
MAX_RETRIES=3
REQUEST_INTERVAL=1
USER_AGENT=paper-radar/0.1
TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=
WECHAT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 中文总结：使用 --summarize 或 summarize <snapshot.json> 开启。
# 模型留空使用默认值；在 .env 中填写 API_KEY，超时单位为秒。
SUMMARY_PROVIDER=deepseek
SUMMARY_MODEL=
API_KEY=
SUMMARY_TIMEOUT=120
